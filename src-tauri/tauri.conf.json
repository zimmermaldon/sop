{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark",
  "version": "1.0.0",
  "identifier": "com.daymark.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 5180",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daymark",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Personal task planner"
  }
}
